{
    "name": "asrbbt_web",
    "version": "0.1.0",
    "description": "WebGPU 지형·건물·도로 뷰어 — 한국 공공데이터 기반 3D 지형과 STL·SKP·3DM·GLB 내보내기",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/asura-balbalta/asura-balbalta.github.io.git"
    },
    "homepage": "https://asura-balbalta.github.io",
    "scripts": {
        "prebuild": "mkdir -p dist/export && cp node_modules/rhino3dm/rhino3dm.min.js node_modules/rhino3dm/rhino3dm.wasm dist/export/",
        "build": "esbuild --bundle src/index.tsx src/*.worker.ts src/export/*.worker.ts --outdir=dist --minify",
        "deploy": "firebase deploy",
        "predev": "mkdir -p dist/export && cp node_modules/rhino3dm/rhino3dm.min.js node_modules/rhino3dm/rhino3dm.wasm dist/export/",
        "dev": "esbuild --bundle src/index.tsx src/*.worker.ts src/export/*.worker.ts --outdir=dist --sourcemap --watch",
        "test": "echo \"Error: no test specified\" && exit 1",
        "typecheck": "tsc --noEmit",
        "render-check": "node scripts/render-check.mjs",
        "band-check": "esbuild scripts/tileBandCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/fb_web/tileBandCheck.mjs && node node_modules/.cache/fb_web/tileBandCheck.mjs",
        "postinstall": "patch-package"
    },
    "author": "asura-balbalta",
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "trailingComma": "all"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.74.9",
        "@fluentui/react-icons": "^2.0.343",
        "@kninnug/constrainautor": "4.1.0",
        "delaunator": "^5.1.0",
        "earcut": "^3.2.4",
        "firebase": "^12.19.0",
        "ol": "^10.10.0",
        "openskp": "^1.3.0",
        "proj4": "^2.22.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rhino3dm": "^8.35.0",
        "styled-components": "^6.5.3",
        "styled-reset": "^5.0.0"
    },
    "devDependencies": {
        "@types/delaunator": "^5.0.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@webgpu/types": "^0.1.74",
        "esbuild": "^0.28.2",
        "firebase-tools": "^15.30.1",
        "patch-package": "^8.0.1",
        "pixelmatch": "^8.0.0",
        "playwright": "^1.64.0",
        "pngjs": "^7.0.0",
        "typescript": "6.0.3"
    }
}
