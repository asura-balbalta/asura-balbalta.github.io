{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["@webgpu/types"]
    },
    "include": ["src"]
}
